  "@type": ["TouristAttraction", "BuddhistTemple", "LandmarksOrHistoricalBuildings", "PlaceOfWorship", "CulturalHeritage"],
  "@id": "https://gatbawi.com/#attraction",
  name: "Gatbawi",
  alternateName: [
    "팔공산 갓바위",
    "Gwanbong Seokjo Yeorae Jwasang",
    "관봉석조여래좌상",
    "Gatbawi Buddha",
    "Stone Hat Buddha",
    "Palgongsan Gatbawi",
    "Stone Seated Medicine Buddha"
  ],
  description:
    "Gatbawi (팔공산 갓바위 / 관봉석조여래좌상) is the Unified Silla era Stone Seated Medicine Buddha at 850-metre Gwanbong Peak, Palgongsan National Park, Daegu, South Korea. Also known as the Stone Hat Buddha and wish-granting Buddha (소원 성취 불상), it is rated 4.6 from 4,632 Google reviews and is a major Daegu day-trip and hiking destination near Seonbonsa and Gwanamsa temples.",
  image: Astro.site ? new URL("/images/gatbawi-wikimedia-real.webp", Astro.site).toString() : undefined,
  url: Astro.site ? new URL("/", Astro.site).toString() : undefined,
  isAccessibleForFree: true,
  address: {
    "@type": "PostalAddress",
    streetAddress: "229 Gatbawi-ro",
    addressLocality: "Dong-gu",
    addressRegion: "Daegu",
    addressCountry: "KR",
    postalCode: "41025",
    name: "229 Gatbawi-ro, Dong-gu, Daegu, South Korea (대구광역시 동구 갓바위로 229)"
  },
  areaServed: { "@type": "City", name: "Daegu" },
  containedInPlace: [
    { "@type": "Place", name: "Palgongsan National Park (팔공산 국립공원)" },
    { "@type": "Place", name: "Gwanbong Peak (관봉, 冠峰, 850 m)" }
  ],
  geo: { "@type": "GeoCoordinates", latitude: 35.9814948, longitude: 128.7367522, elevation: "850 m" },
  hasMap: "https://maps.app.goo.gl/VmyckMsmn6p4hq1LA",
  map: "https://maps.app.goo.gl/VmyckMsmn6p4hq1LA",
  sameAs: [
    "https://en.wikipedia.org/wiki/Gatbawi",
    "https://www.wikidata.org/wiki/Q12583597",
    "https://english.visitkorea.or.kr",
