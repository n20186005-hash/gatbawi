---
/** Style note: The header uses a stone-seal brand mark and a measured trail-marker navigation rhythm. */
const english = Astro.url.pathname.startsWith("/en/");
const topic = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand" href="/" aria-label={english ? "Palgongsan Gatbawi guide home" : "팔공산 갓바위 방문 안내 홈"}>
      <span class="brand-symbol" role="img" aria-label="갓바위 모자와 산 능선을 형상화한 안내 표식"></span>
      <span class="brand-copy">
        <strong><span class="copy-ko">팔공산 갓바위</span><span class="copy-en">PALGONGSAN GATBAWI</span></strong>
        <small><span class="copy-ko">독립 방문 안내</span><span class="copy-en">INDEPENDENT VISITOR GUIDE</span></small>
      </span>
    </a>
    <nav class="site-nav" aria-label={english ? "Main navigation" : "주요 탐색"}>
      <a href="/#understanding"><span class="copy-ko">소개</span><span class="copy-en">Context</span></a>
      <a href="/#arrival"><span class="copy-ko">방문 준비</span><span class="copy-en">Plan</span></a>
      <a href="/#route"><span class="copy-ko">교통</span><span class="copy-en">Access</span></a>
      <a href="/#map"><span class="copy-ko">지도</span><span class="copy-en">Map</span></a>
    </nav>
    <div class="language-toggle" aria-label={english ? "Language" : "언어 선택"}>
      <a data-language-link href={topic} lang="ko">한국어</a>
      <a data-language-link href={topic === "/" ? "/en/" : `/en${topic}`} lang="en">EN</a>
    </div>
  </div>
</header>
