---
/** Style note: A restrained Korean mountain-temple editorial shell using granite, rice-paper warmth and cinnabar wayfinding. */
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_NAME } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const lang = Astro.url.pathname.startsWith("/en/") ? "en" : "ko";
const topic = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const {
  title = SITE_NAME,
  description = lang === "en" ? "Visit Palgongsan Gatbawi: understand the stone Buddha, compare Daegu and Gyeongsan approaches, and check access, weather and respectful visiting advice." : "팔공산 갓바위 석불의 의미, 대구·경산 접근로, 입산 확인사항과 날씨·방문 예절을 정리한 독립 안내입니다.",
  noIndex = false
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = Astro.site
  ? new URL("/images/gatbawi-wikimedia-real.webp", Astro.site).toString()
  : undefined;
---

<!doctype html>
<html lang={lang} data-language={lang} class:list={{"lang-en": lang === "en"}}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#b64a35" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <><link rel="alternate" hreflang="ko" href={new URL(topic, Astro.site).href} /><link rel="alternate" hreflang="en" href={new URL(topic === "/" ? "/en/" : `/en${topic}`, Astro.site).href} /><link rel="alternate" hreflang="x-default" href={new URL(topic, Astro.site).href} /></>}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:locale" content={lang === "en" ? "en_US" : "ko_KR"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "ko_KR" : "en_US"} />
    <meta property="og:image:alt" content="Gatbawi Buddha photographed by Barnkim in 2007; historical image" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16.svg" sizes="16x16" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.svg" sizes="32x32" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="갓바위 안내" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Serif+KR:wght@500;600;700&family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <span class="copy-ko">본문으로 건너뛰기</span><span class="copy-en">Skip to content</span>
    </a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <Footer />
    <script is:inline src="/analytics.js"></script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
